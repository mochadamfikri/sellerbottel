# DEV ONLY - Bot 2 intentionally shares the MAIN bot database.
# WARNING: this is NOT data-isolated. Stock/orders/users/promos are shared with production.
APP_ENV=development
PROMOTION_ENABLED=true

MONGO_URL=mongodb://localhost:27017
DB_NAME=sellerbottel

# DEV Telegram bot - NEVER use the production bot token here.
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
CORS_ORIGINS=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
TRUST_PROXY=true

# Admin
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=

# Inventory encryption
INVENTORY_ENCRYPTION_KEY=

# Local product storage
LOCAL_STORAGE_DIR=/opt/sellerbottel-dev/backend/storage_data

# Optional GoPay / payment variables: copy the existing names from production as needed.
GOPAY_ENABLED=false
GOPAY_LOGIN_METHOD=email_otp
GOPAY_EMAIL=
GOPAY_PASSWORD=
GOPAY_PHONE=
GOPAY_QRIS_STRING=
GOPAY_POLL_INTERVAL=15

# Telegram MTProto
TG_API_ID=
TG_API_HASH=
TG_SESSION_KEY=

# Promotion safety limits
PROMO_MIN_INTERVAL_SECONDS=300
PROMO_DAILY_LIMIT=20

# Bot 2 - separate Telegram bot, same DEV MongoDB/database
BOT2_ENABLED=true
BOT2_TELEGRAM_TOKEN=
BOT2_WEBHOOK_SECRET=
BOT2_PUBLIC_BASE_URL=
BOT2_PAYMENT_POLL_INTERVAL=15
