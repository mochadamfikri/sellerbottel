APP_ENV=development
PROMOTION_ENABLED=true

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
CORS_ORIGINS=https://your-admin-domain.example
COOKIE_SAMESITE=lax
TRUST_PROXY=true

# Admin
# JWT_SECRET: string acak panjang untuk menandatangani token login admin (wajib)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=

# Mongo
MONGO_URL=mongodb://localhost:27017
DB_NAME=sellerbottel

# Inventory encryption (Fernet key) - WAJIB diisi, tanpa ini import/simpan inventory gagal.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Jangan diganti setelah ada data inventory, data lama tidak akan bisa dibaca lagi.
INVENTORY_ENCRYPTION_KEY=

# Local product file storage (optional; defaults to backend/storage_data)
LOCAL_STORAGE_DIR=/opt/sellerbottel/backend/storage_data

# Optional GoPay Merchant / QRIS
GOPAY_ENABLED=false
# email_otp = login email + OTP, otp = phone + OTP, password = legacy
GOPAY_LOGIN_METHOD=email_otp
GOPAY_EMAIL=
GOPAY_PASSWORD=
GOPAY_PHONE=
GOPAY_QRIS_STRING=
GOPAY_POLL_INTERVAL=15

# Telegram MTProto / akun outreach (jangan pernah commit nilai rahasia)
TG_API_ID=
TG_API_HASH=
TG_SESSION_KEY=
