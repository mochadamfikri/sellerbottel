# Telegram
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
CORS_ORIGINS=https://your-admin-domain.example
COOKIE_SAMESITE=lax
TRUST_PROXY=true

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=

# Mongo
MONGO_URL=mongodb://localhost:27017
DB_NAME=sellerbottel

# Inventory encryption (Fernet key)
INVENTORY_ENCRYPTION_KEY=

# Local product file storage (optional; defaults to backend/storage_data)
LOCAL_STORAGE_DIR=/opt/sellerbottel/backend/storage_data

# Optional GoPay Merchant / QRIS
GOPAY_ENABLED=false
GOPAY_LOGIN_METHOD=password
GOPAY_EMAIL=
GOPAY_PASSWORD=
GOPAY_PHONE=
GOPAY_QRIS_STRING=
GOPAY_POLL_INTERVAL=15
